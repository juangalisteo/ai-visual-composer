{
    "mode": "word_by_word",

    "min_duration": 0.30,
    "max_duration": 1.20,
    "significant_gap_threshold": 0.35,
    "micro_cues": {
        "enabled": true,
        "min_frames": 1,
        "min_display_seconds": 0.05,
        "merge_preference": "next"
    },

    "uppercase": false,
    "remove_extra_commas": true
}
