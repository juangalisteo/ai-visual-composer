{
    "component": "imagen",
    "platform": "youtube",
    "family": "estandar",
    "profile_id": "subtitulo_imagen_youtube_palabra_por_palabra",
    "display_name": "Palabra por palabra",
    "cue_policy": {
        "mode": "word_by_word",
        "min_duration": 0.30,
        "max_duration": 1.20,
        "significant_gap_threshold": 0.35,
        "micro_cues": {
