{
    "component": "imagen",
    "platform": "youtube",
    "profile_id": "subtitulo_imagen_youtube_linea_unica",
    "style": "single_line",
    "cue_policy": {
        "mode": "single_line",
        "max_chars_per_line": 60,
        "min_duration": 1.0,
        "max_duration": 3.0,
        "significant_gap_threshold": 0.35,
        "split_on_punctuation": true,
        "avoid_orphan_words": true,
        "merge_short_chunks": true,
        "balance_duration": true
    },
    "render_style": {
        "font": "gotham",
        "font_size": 16,
        "bold": false,
        "primary_colour": "&H00FFFFFF",
        "outline_colour": "&H00000000",
        "back_colour": "&H00000000",
        "border_style": 1,
        "outline": 0,
        "shadow": 1,
        "alignment": 2,
        "margin_v": 25,
        "offset": 0.0
    }
}
