{
  "component": "studio",
  "format": "vertical",
  "family": "minimalista",
  "profile_id": "subtitulo_studio_vertical_highlight_in_sentence",
  "display_name": "Palabra en color",
  "cue_policy": {
    "mode": "single_line",
    "text_case": "uppercase",
    "max_chars_per_line": 29,
    "min_duration": 1.0,
    "max_duration": 3.5,
    "significant_gap_threshold": 0.35,
    "punctuation": {
      "remove_commas": false,
      "remove_periods": false,
      "remove_colons": false,
      "remove_semicolons": false,
      "remove_question_marks": false,
      "remove_exclamation_marks": false,
      "remove_ellipsis": false,
      "remove_hyphens": false,
      "remove_em_dashes": false,
      "remove_double_quotes": false,
      "remove_single_quotes": false,
      "remove_parentheses": false
    }
  },
  "render_style": {
    "font": "unisans",
    "font_size": 10,
    "bold": false,
    "italic": false,
    "underline": false,
    "strikeout": false,
    "primary_colour": "&H0000FFFF",
    "secondary_colour": "&H00FFFFFF",
    "outline_colour": "&H80000000",
    "back_colour": "&H00000000",
    "border_style": 1,
    "outline": 0,
    "shadow": 1,
    "alignment": 2,
    "margin_v": 55,
    "margin_l": 0,
    "margin_r": 0,
    "scale_x": 100.0,
    "scale_y": 100.0,
    "spacing": 0.0,
    "offset": 0.0,
    "dynamic": true,
    "cue_effect": "none",
    "word_effect": "highlight_in_sentence"
  }
}
