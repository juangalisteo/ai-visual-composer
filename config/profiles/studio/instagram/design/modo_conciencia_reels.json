{
    "component": "studio",
    "platform": "instagram",
    "family": "design",
    "profile_id": "studio_instagram_design_modo_conciencia_reels",
    "display_name": "Modo Conciencia | Reels",

    "subtitle_config": "word_by_word",

    "subtitle_profile": {
        "style": "word_by_word",

        "cue_policy": {
            "mode": "word_by_word",
            "min_duration": 0.30,
            "max_duration": 1.20,
            "significant_gap_threshold": 0.35,

            "micro_cues": {
                "enabled": true,
                "min_frames": 1,
                "min_display_seconds": 0.05,
                "merge_preference": "next"
            },

            "uppercase": true,

            "punctuation": {
                "remove_commas": true,
                "remove_periods": true,
                "remove_colons": false,
                "remove_semicolons": false,
                "remove_question_marks": false,
                "remove_exclamation_marks": false,
                "remove_ellipsis": false,
                "remove_hyphens": false,
                "remove_em_dashes": false,
                "remove_double_quotes": false,
                "remove_single_quotes": false,
                "remove_parentheses": false
            }
        },

        "render_style": {
            "font": "oswald",
            "font_size": 22,
            "bold": true,
            "primary_colour": "&H00FFFFFF",
            "outline_colour": "&H80000000",
            "back_colour": "&H00000000",
            "border_style": 1,
            "outline": 0,
            "shadow": 1,
            "alignment": 2,
            "margin_v": 55,
            "offset": 0.0
        }
    },

    "format": "vertical",
    "resolution": "1080x1920",

    "studio": {
        "input": {
            "video_extensions": [
                ".mp4"
            ],
            "subtitle_extensions": [
                ".srt"
            ]
        },

        "output": {
            "width": 1080,
            "height": 1920,
            "fps": 30,

            "video": {
                "codec": "libx264",
                "preset": "slow",
                "crf": 16,
                "pixel_format": "yuv420p",
                "movflags": "+faststart"
            },

            "audio": {
                "codec": "aac",
                "bitrate": "192k",
                "sample_rate": 48000,
                "channels": 2
            },

            "validation": {
                "max_duration_difference": 0.2
            }
        },

        "montage": {
            "transition_duration": 0.25
        },

        "music": {
            "volume": 0.10,
            "loop_shorter": true,
            "limiter_limit": 0.95
        }
    }
}