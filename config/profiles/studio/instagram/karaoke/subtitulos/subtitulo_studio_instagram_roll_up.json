{
  "component": "studio",
  "platform": "instagram",
  "family": "karaoke",
  "profile_id": "subtitulo_studio_instagram_roll_up",
  "display_name": "Desplazamiento vertical",
  "cue_policy": {
    "mode": "roll_up",
    "text_case": "original",
    "max_chars_per_line": 40,
    "visible_lines": 3,
    "significant_gap_threshold": 0.35,
    "punctuation": {
      "remove_commas": false,
      "remove_periods": false,
      "remove_colons": false,
      "remove_semicolons": false,
      "remove_question_marks": false,
      "remove_exclamation_marks": false,
      "remove_ellipsis": false,
      "remove_hyphens": false,
      "remove_em_dashes": false,
      "remove_double_quotes": false,
      "remove_single_quotes": false,
      "remove_parentheses": false
    }
  },
  "render_style": {
    "font": "gotham",
    "font_size": 10,
    "bold": false,
    "italic": false,
    "underline": false,
    "strikeout": false,
    "primary_colour": "&H00FFFFFF",
    "secondary_colour": "&H00000000",
    "outline_colour": "&H00000000",
    "back_colour": "&H00000000",
    "border_style": 1,
    "outline": 0,
    "shadow": 1,
    "alignment": 1,
    "margin_v": 55,
    "margin_l": 50,
    "margin_r": 50,
    "scale_x": 100.0,
    "scale_y": 100.0,
    "spacing": 0.0,
    "offset": 0.0,
    "dynamic": true,
    "cue_effect": "none",
    "word_effect": "none",
    "scroll_duration_ms": 200
  }
}
