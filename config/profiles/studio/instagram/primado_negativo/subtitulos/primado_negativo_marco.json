{
  "component": "studio",
  "platform": "instagram",
  "family": "primado_negativo",
  "profile_id": "primado_negativo_marco",
  "display_name": "Primado Negativo | Marco",
  "cue_policy": {
    "mode": "three_two_words",
    "max_chars_per_line": 24,
    "min_duration": 0.30,
    "max_duration": 1.20,
    "significant_gap_threshold": 0.35,
    "text_case": "original",
    "punctuation": {
      "remove_commas": false,
      "remove_periods": false,
      "remove_colons": false,
      "remove_semicolons": true,
      "remove_question_marks": false,
      "remove_exclamation_marks": false,
      "remove_ellipsis": false,
      "remove_hyphens": false,
      "remove_em_dashes": false,
      "remove_double_quotes": false,
      "remove_single_quotes": false,
      "remove_parentheses": false
    }
  },
  "render_style": {
    "font": "anton",
    "font_size": 22,
    "bold": true,
    "primary_colour": "&H00FFFFFF",
    "outline_colour": "&H80000000",
    "back_colour": "&H00000000",
    "border_style": 1,
    "outline": 0,
    "shadow": 1,
    "alignment": 2,
    "margin_v": 55,
    "offset": 0.0
  }
}