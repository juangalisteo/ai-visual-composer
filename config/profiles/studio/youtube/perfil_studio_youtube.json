{
    "component": "studio",
    "platform": "youtube",
    "profile_id": "studio_youtube",
    "format": "horizontal",
    "resolution": "1920x1080",
    "studio": {
        "input": {
            "video_extensions": [".mp4"],
            "subtitle_extensions": [".srt"]
        },
        "output": {
            "width": 1920,
            "height": 1080,
            "fps": 30,
            "video": {
                "codec": "libx264",
                "preset": "slow",
                "crf": 16,
                "pixel_format": "yuv420p",
                "movflags": "+faststart"
            },
            "audio": {
                "codec": "aac",
                "bitrate": "192k",
                "sample_rate": 48000,
                "channels": 2
            },
            "validation": {
                "max_duration_difference": 0.2
            }
        },
        "light_leaks": {
            "enabled": false
        },
        "music": {
            "enabled": false
        }
    }
}
