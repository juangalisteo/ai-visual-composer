    "primary_colour": "&H00FFFFFF", "secondary_colour": "&H00000000", "outline_colour": "&H80000000", "back_colour": "&H00000000",
    "border_style": 1, "outline": 0, "shadow": 1, "alignment": 2,
    "margin_v": 55, "margin_l": 0, "margin_r": 0, "spacing": 0.0,
    "offset": 0.0, "dynamic": false, "cue_effect": "none", "word_effect": "none"
  }
