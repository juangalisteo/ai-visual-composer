{
    "component": "video",
    "platform": "instagram",
    "profile_id": "subtitulo_video_instagram_linea_unica",
    "style": "single_line",
    "cue_policy": {
        "mode": "single_line",
        "max_chars_per_line": 60,
        "min_duration": 1.0,
        "max_duration": 3.0,
        "significant_gap_threshold": 0.35,
        "split_on_punctuation": true,
        "avoid_orphan_words": true,
        "merge_short_chunks": true,
        "balance_duration": true,
        "punctuation": {
            "remove_commas": false,
            "remove_periods": false,
            "remove_colons": false,
            "remove_semicolons": false,
            "remove_question_marks": false,
            "remove_exclamation_marks": false,
            "remove_ellipsis": false,
            "remove_hyphens": false,
            "remove_em_dashes": false,
            "remove_double_quotes": false,
            "remove_single_quotes": false,
            "remove_parentheses": false
        }
    },
    "render_style": {
        "font": "unisans",
        "font_size": 14,
        "bold": false,
        "primary_colour": "&H00FFFFFF",
        "outline_colour": "&H80000000",
        "back_colour": "&H00000000",
        "border_style": 1,
        "outline": 0,
        "shadow": 1,
        "alignment": 2,
        "margin_v": 55,
        "offset": -0.06
    }
}
